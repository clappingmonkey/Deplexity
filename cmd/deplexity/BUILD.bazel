load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "deplexity_lib",
    srcs = ["main.go"],
    importpath = "github.com/clappingmonkey/deplexity/cmd/deplexity",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/api",
        "//internal/auth",
        "//internal/client",
        "//internal/export",
        "//internal/models",
        "@com_github_alecthomas_kong//:kong",
        "@com_github_schollz_progressbar_v3//:progressbar",
    ],
)

go_binary(
    name = "deplexity",
    embed = [":deplexity_lib"],
    visibility = ["//visibility:public"],
    x_defs = {
        "main.version": "{STABLE_VERSION}",
        "main.buildTime": "{BUILD_TIMESTAMP}",
    },
)

go_test(
    name = "deplexity_test",
    srcs = ["main_test.go"],
    embed = [":deplexity_lib"],
    deps = [
        "//internal/export",
        "//internal/models",
    ],
)
