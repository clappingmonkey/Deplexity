module(
    name = "deplexity",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.42.0")

# Go SDK — version read from go.mod
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# External Go dependencies from go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_alecthomas_kong",
    "com_github_go_rod_rod",
    "com_github_gpdf_dev_gpdf",
    "com_github_refraction_networking_utls",
    "com_github_schollz_progressbar_v3",
    "org_golang_x_net",
)
